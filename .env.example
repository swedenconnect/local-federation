#
# Variables of the local federation. Copy this file to .env, next to docker-compose.yml, and change what you need.
# .env is git-ignored. Without a .env file, the defaults below are used.
#

# The image of the Sweden Connect reference authentication server. To use a local build, built from
# https://github.com/swedenconnect/spring-authentication-server, set it to the local image, for example
# local/sweden-connect-reference-authn-server:1.0.0-SNAPSHOT. See docs/setup.md.
REFERENCE_AUTHN_SERVER_IMAGE=ghcr.io/swedenconnect/sweden-connect-reference-authn-server:latest

# The image of Test my eID.
TEST_MY_EID_IMAGE=ghcr.io/swedenconnect/test-my-eid:4.0.0

# The image of the OpenID Federation service. To use a snapshot or a local build, built from
# https://github.com/swedenconnect/openid-federation-services, set it to that image. See docs/setup.md.
OPENID_FEDERATION_IMAGE=ghcr.io/swedenconnect/openid-federation-services:latest

# The password of Redis.
REDIS_PASSWORD=supersecret
